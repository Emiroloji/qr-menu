# Canlı ortam değişkenleri. Bu dosyayı .env.production olarak kopyalayıp doldurun.
# .env.production depoya girmez (.gitignore).

# Alan adı (DNS A kaydı VPS'in IP adresine yönlenmiş olmalı)
DOMAIN=menu.ornek.com
NEXT_PUBLIC_APP_URL=https://menu.ornek.com
BETTER_AUTH_URL=https://menu.ornek.com
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Veritabanı (docker-compose.prod.yml içindeki PostgreSQL)
POSTGRES_USER=qrmenu
# openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=qrmenu
# POSTGRES_PASSWORD ile aynı parolayı yazın
DATABASE_URL=postgresql://qrmenu:PAROLA@db:5432/qrmenu?schema=public

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_ENDPOINT=

# SMTP (şifre belirleme / sıfırlama e-postaları)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="QR Menü <no-reply@ornek.com>"

# İlk kurulumda süper admin hesabı (npx prisma db seed)
SEED_ADMIN_EMAIL=
SEED_PASSWORD=
