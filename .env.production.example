# Canlı ortam değişkenleri. Bu dosyayı .env.production olarak kopyalayıp doldurun.
# .env.production depoya girmez (.gitignore).

# Alan adı (DNS A kaydı VPS'in IP adresine yönlenmiş olmalı)
DOMAIN=menu.ornek.com
NEXT_PUBLIC_APP_URL=https://menu.ornek.com
BETTER_AUTH_URL=https://menu.ornek.com
# Alan adı YOKKEN (geçici, IP ile, HTTPS olmadan):
#   DOMAIN=:80
#   NEXT_PUBLIC_APP_URL=http://203.0.113.10
#   BETTER_AUTH_URL=http://203.0.113.10
# DİKKAT: QR kodlar NEXT_PUBLIC_APP_URL adresini kullanır. Alan adı gelmeden QR BASTIRMAYIN.
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Veritabanı (docker-compose.prod.yml içindeki PostgreSQL)
POSTGRES_USER=qrmenu
# openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=qrmenu
# POSTGRES_PASSWORD ile aynı parolayı yazın
DATABASE_URL=postgresql://qrmenu:PAROLA@db:5432/qrmenu?schema=public

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_ENDPOINT=

# SMTP (şifre belirleme / sıfırlama e-postaları)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="QR Menü <no-reply@ornek.com>"

# İlk kurulumda süper admin hesabı (npx prisma db seed)
SEED_ADMIN_EMAIL=
SEED_PASSWORD=

# Hata izleme (GlitchTip, isteğe bağlı "monitoring" profili). Ücretsiz, kendi sunucumuzda.
# openssl rand -hex 32
GLITCHTIP_SECRET_KEY=
# openssl rand -hex 16
GLITCHTIP_DB_PASSWORD=
# Tarayıcıdan açılacak adres: alan adı yokken http://<IP>:8000
GLITCHTIP_DOMAIN=http://203.0.113.10:8000
GLITCHTIP_SITE=:8000
# GlitchTip'te proje oluşturunca verilen DSN; sunucu içinden erişim için ana makineyi
# "glitchtip:8000" yapın. Ör: http://ANAHTAR@glitchtip:8000/1 — boşsa hata gönderilmez.
SENTRY_DSN=

# Zamanlanmış görevler (abonelik bitiş hatırlatması e-postası). openssl rand -hex 32
CRON_SECRET=
