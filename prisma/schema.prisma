generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Fiyatlar kuruş cinsinden Int tutulur (45,50 TL → 4550).
// Çeviriler `translations` JSON alanındadır: { "en": { "name": "...", "description": "..." } }.
// Türkçe metin ana alanlardadır (name, description).
// Business, Branch, Category ve Product yumuşak silinir (deletedAt).

// ---------- Enum'lar ----------

enum Role {
  SUPER_ADMIN
  OWNER
  STAFF
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum AllergenLevel {
  CONTAINS
  MAY_CONTAIN
}

enum Badge {
  CHEFS_CHOICE
  NEW
  POPULAR
}

enum Permission {
  PRODUCT_TOGGLE_AVAILABILITY
  PRODUCT_EDIT_PRICE
  PRODUCT_EDIT
  CATEGORY_EDIT
  CAMPAIGN_EDIT
}

// ---------- Paket ve abonelik ----------

model Plan {
  id            String         @id @default(cuid())
  name          String         @unique
  price         Int // kuruş
  // null = sınırsız
  maxBranches   Int?
  maxProducts   Int?
  maxStaff      Int?
  maxLanguages  Int?
  features      Json           @default("{}")
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id             String             @id @default(cuid())
  businessId     String
  business       Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planId         String
  plan           Plan               @relation(fields: [planId], references: [id])
  startsAt       DateTime
  endsAt         DateTime
  status         SubscriptionStatus @default(ACTIVE)
  // Bitişe 7 gün kala gönderilen e-posta (Faz 2.5); süre uzatılınca sıfırlanır.
  reminderSentAt DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([businessId, endsAt])
}

// ---------- İşletme ve şube ----------

model Business {
  id                     String         @id @default(cuid())
  name                   String
  slug                   String         @unique
  logoUrl                String?
  coverUrl               String? // Menü kapak görseli (Faz 1.7)
  // İşletmenin kendi alan adı (Pro, Faz 3.2), ör. "menu.isletme.com". DNS'i sunucumuzu
  // gösterdiği doğrulanınca `customDomainVerifiedAt` dolar ve alan adı yayına girer.
  customDomain           String?        @unique
  customDomainVerifiedAt DateTime?
  // Tema kodu (components/menu/themes/ altındaki dosya adı). Yeni tema eklemek
  // migration gerektirmesin diye enum değil.
  theme                  String         @default("minimal")
  primaryColor           String         @default("#2F5D50")
  isActive               Boolean        @default(true)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  deletedAt              DateTime?
  branches               Branch[]
  subscriptions          Subscription[]
  users                  User[]
}

model Branch {
  id            String         @id @default(cuid())
  businessId    String
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String
  slug          String
  address       String?
  phone         String?
  wifi          String?
  socials       Json           @default("{}") // { "instagram": "...", ... }
  openingHours  Json           @default("{}") // { "mon": [["08:00", "23:00"]], ... }
  languages     String[]       @default(["tr"])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  categories    Category[]
  scanLogs      ScanLog[]
  productViews  ProductView[]
  campaigns     Campaign[]
  dailySpecials DailySpecial[]

  @@unique([businessId, slug])
}

// ---------- Menü ----------

model Category {
  id            String    @id @default(cuid())
  branchId      String
  branch        Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  sortOrder     Int       @default(0)
  isVisible     Boolean   @default(true)
  availableFrom String? // "HH:mm", saate göre menü (Faz 2.4)
  availableTo   String? // "HH:mm"
  translations  Json      @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  products      Product[]

  @@index([branchId, sortOrder])
}

model Product {
  id            String            @id @default(cuid())
  categoryId    String
  category      Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  ingredients   String?
  portion       String?
  spiceLevel    Int               @default(0) // 0 = acı değil, 1–3
  prepTime      Int? // dakika
  origin        String?
  isAvailable   Boolean           @default(true)
  isVisible     Boolean           @default(true)
  isFeatured    Boolean           @default(false) // Menüde "Öne çıkanlar" alanı (Faz 2.3)
  badges        Badge[]
  sortOrder     Int               @default(0)
  translations  Json              @default("{}")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?
  variants      ProductVariant[]
  images        ProductImage[]
  nutrition     Nutrition?
  allergens     ProductAllergen[]
  tags          ProductTag[]
  views         ProductView[]
  dailySpecials DailySpecial[]

  @@index([categoryId, sortOrder])
}

// Her ürünün en az bir varyantı olur; tek fiyatlı ürünlerde name boştur.
model ProductVariant {
  id           String  @id @default(cuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name         String?
  price        Int // kuruş
  sortOrder    Int     @default(0)
  translations Json    @default("{}")

  @@index([productId, sortOrder])
}

model ProductImage {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url         String
  blurDataUrl String?
  sortOrder   Int     @default(0)

  @@index([productId, sortOrder])
}

model Nutrition {
  productId String  @id
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  calories  Int? // kcal
  protein   Float? // g
  carbs     Float? // g
  fat       Float? // g
  sugar     Float? // g
  salt      Float? // g
}

// ---------- Kampanyalar (Faz 2.3) ----------

// Menünün üstündeki kampanya banner'ı. Görsel ürün görselleri gibi 400/800/1200 px
// WebP olarak saklanır (`{imageUrl}-800.webp`). Çeviriler { "en": { "name": başlık,
// "description": açıklama } } biçimindedir (ortak çeviri yapısı).
model Campaign {
  id           String   @id @default(cuid())
  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  imageUrl     String?
  blurDataUrl  String?
  startsAt     DateTime // Türkiye saatiyle günün başı
  endsAt       DateTime // Türkiye saatiyle günün sonu
  isActive     Boolean  @default(true)
  translations Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([branchId, endsAt])
}

// Günün önerisi: bir şubede belirli bir günde öne çıkarılan ürün. İleri tarihler için
// önceden planlanabilir; o gün geçince menüde görünmez.
model DailySpecial {
  id        String   @id @default(cuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date // Türkiye saatiyle gün
  createdAt DateTime @default(now())

  @@unique([branchId, date])
}

// ---------- Alerjen ve etiket (seed ile gelir) ----------

model Allergen {
  id           String            @id @default(cuid())
  code         String            @unique
  name         String
  icon         String
  translations Json              @default("{}")
  products     ProductAllergen[]
}

model ProductAllergen {
  productId  String
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  allergenId String
  allergen   Allergen      @relation(fields: [allergenId], references: [id], onDelete: Cascade)
  level      AllergenLevel

  @@id([productId, allergenId])
}

model Tag {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  icon         String
  translations Json         @default("{}")
  products     ProductTag[]
}

model ProductTag {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

// ---------- Kullanıcı (Better Auth) ve yetki ----------

model User {
  id            String            @id
  name          String
  email         String            @unique
  emailVerified Boolean           @default(false)
  image         String?
  role          Role              @default(STAFF)
  businessId    String?
  business      Business?         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  sessions      Session[]
  accounts      Account[]
  permissions   StaffPermission[]

  @@index([businessId])
}

model StaffPermission {
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission

  @@id([userId, permission])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------- İstatistik ----------

// IP adresi veya kişisel veri tutulmaz.
model ScanLog {
  id        String   @id @default(cuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  language  String
  device    String? // "mobile" | "tablet" | "desktop"

  @@index([branchId, createdAt])
}

// Müşterinin menüde ürün detayını açması ("en çok açılan ürünler", Faz 2.2).
// Tarama kaydı gibi IP adresi veya kişisel veri tutulmaz.
model ProductView {
  id        String   @id @default(cuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([branchId, createdAt])
}
