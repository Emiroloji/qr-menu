# DOMAIN .env.production içinde tanımlanır:
#  - alan adı varsa (ör. menu.ornek.com) Caddy SSL'i otomatik alır ve yeniler;
#  - alan adı yokken ":80" → yalnızca HTTP, sunucunun IP adresiyle.
{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy app:3000
}

# Hata izleme paneli (GlitchTip, "monitoring" profili). Alan adı yokken :8000 (HTTP);
# alan adı gelince ör. GLITCHTIP_SITE=hata.ornek.com (HTTPS).
{$GLITCHTIP_SITE} {
	reverse_proxy glitchtip:8000
}
