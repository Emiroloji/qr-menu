DATABASE_URL="postgresql://qrmenu:qrmenu@localhost:5432/qrmenu?schema=public"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:3000"
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Yerelde docker-compose içindeki S3Mock: R2_ENDPOINT="http://localhost:9090", R2_BUCKET="qrmenu",
# R2_PUBLIC_URL="http://localhost:9090/qrmenu". Canlıda R2_ENDPOINT boş bırakılır (R2_ACCOUNT_ID kullanılır).
R2_ENDPOINT=
R2_PUBLIC_URL=
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seed (prisma/seed.ts). Canlıda SEED_PASSWORD zorunlu.
SEED_ADMIN_EMAIL="admin@qrmenu.local"
SEED_PASSWORD=

# E-posta (SMTP). Yerelde docker-compose içindeki Mailpit kullanılır.
# localhost yazmayın: nodemailer 10.2+ adı kendi DNS sorgusuyla çözer ve "localhost"ta zaman aşımına düşer.
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="QR Menü <no-reply@qrmenu.local>"

# Zamanlanmış görevler (abonelik bitiş hatırlatması). Uzun, rastgele bir değer: openssl rand -hex 32
CRON_SECRET=

# Dış yedek (canlı, isteğe bağlı): gece yedekleri bu GİZLİ R2 deposuna da kopyalanır.
# Görsel deposundan ayrı olmalı (o herkese açık). Anahtar yalnızca bu depoya yetkili olsun.
R2_BACKUP_BUCKET=
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=
